# 生产环境必填
APP_ID=your-app-id
APP_SECRET=replace-with-a-random-secret
GUEST_TOKEN_SECRET=replace-with-a-separate-random-secret
DATABASE_URL=mysql://user:password@host:3306/truthlens

# Kimi AgentGW（二选一：环境变量，或部署平台中安全挂载 .agent-gw.json）
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://your-agent-gateway.example
KIMI_CHAT_ID=

# 首次启动且数据库中尚无管理员时使用；请设置为至少 12 个字符的随机强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password

# ── LLM 判定通道（可选）────────────────────────────────────────
# agent-gw 凭证无 chat 权限时配置；任意 OpenAI 兼容平台均可，三变量需同时设置。
#   DeepSeek:      LLM_BASE_URL=https://api.deepseek.com        LLM_MODEL=deepseek-chat
#   Kimi 开放平台: LLM_BASE_URL=https://api.moonshot.cn/v1      LLM_MODEL=kimi-k2.5
#   智谱:          LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.5-flash
#   通义:          LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
